{
  "expo": {
    "name": "RN Expo Boilerplate",
    "slug": "rn-expo-boilerplate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "rnexpoboilerplate",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.rnexpoboilerplate",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "rnexpoboilerplate",
            "CFBundleURLSchemes": ["rnexpoboilerplate"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yourcompany.rnexpoboilerplate",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "yourapp.com"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.yourcompany.rnexpoboilerplate",
          "enableGooglePay": true
        }
      ],
      [
        "react-native-purchases",
        {
          "useAmazon": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
