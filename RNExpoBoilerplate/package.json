{
  "name": "rn-expo-boilerplate",
  "version": "1.0.0",
  "description": "A comprehensive React Native Expo boilerplate with authentication, payments, and modern tooling",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "expo start --clear",
    "doctor": "expo doctor"
  },
  "keywords": [
    "react-native",
    "expo",
    "typescript",
    "boilerplate",
    "authentication",
    "payments",
    "supabase",
    "stripe",
    "revenuecat",
    "tailwindcss",
    "nativewind"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "1.25.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@stripe/stripe-react-native": "0.40.0",
    "@supabase/supabase-js": "^2.48.1",
    "@tanstack/react-query": "^5.62.9",
    "expo": "~52.0.0",
    "expo-auth-session": "~6.0.1",
    "expo-constants": "~17.0.3",
    "expo-crypto": "~14.0.1",
    "expo-dev-client": "~5.0.6",
    "expo-linking": "~7.0.3",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.9",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.15",
    "expo-status-bar": "~2.0.0",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-purchases": "^8.7.3",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "@types/react-native": "^0.73.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/rn-expo-boilerplate.git"
  },
  "homepage": "https://github.com/yourusername/rn-expo-boilerplate#readme",
  "bugs": {
    "url": "https://github.com/yourusername/rn-expo-boilerplate/issues"
  },
  "private": false
}
